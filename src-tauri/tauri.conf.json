{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "questiongen",
  "version": "5.2.1",
  "identifier": "com.andy.questiongen",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "decorations": false,
        "title": "questiongen",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../exams/*",
      "../reports/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMTc3NTYwQzRDQjBCODMKUldTREM4dkVZSFVYY2JqaGFGTDF6QUg2SjNGdVZ3MkFVRUthUHMrR3l0UzBtRmdFYTV1NG5EUFYK",
      "endpoints": [
        "https://github.com/flandolf/questiongen/releases/latest/download/latest.json"
      ]
    }
  }
}
